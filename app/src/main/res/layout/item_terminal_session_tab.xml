<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_tab_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_tab_inactive"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="140dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="2dp">

    <View
        android:id="@+id/session_tab_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/dot_session_inactive" />

    <TextView
        android:id="@+id/session_tab_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/terminal_text_secondary"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/close_tab_button"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_chrome_button_ripple"
        android:contentDescription="@string/action_close_session_tab"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close_tab"
        app:tint="@color/terminal_text_secondary" />

</LinearLayout>
