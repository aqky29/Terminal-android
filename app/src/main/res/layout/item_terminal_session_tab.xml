<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_tab_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_tab_inactive"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="140dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">

    <ImageButton
        android:id="@+id/close_tab_button"
        android:layout_width="26dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_chrome_button_ripple"
        android:contentDescription="@string/action_close_session_tab"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close_tab"
        android:visibility="invisible"
        app:tint="@color/terminal_text_secondary" />

    <TextView
        android:id="@+id/session_tab_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:textColor="@color/terminal_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/session_tab_shortcut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/terminal_text_secondary"
        android:textSize="10.5sp" />

</LinearLayout>
