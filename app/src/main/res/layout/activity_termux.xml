<?xml version="1.0" encoding="utf-8"?>
<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Phone compact header (48dp portrait, 44dp landscape via dimens) -->
    <LinearLayout
        android:id="@+id/top_chrome_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/terminal_top_chrome_height"
        android:background="@color/terminal_bg_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/terminal_top_chrome_padding_horizontal">

        <ImageButton
            android:id="@+id/open_drawer_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chrome_button_ripple"
            android:contentDescription="@string/action_open_sessions_drawer"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sessions_menu"
            app:tint="@color/terminal_text_primary" />

        <TextView
            android:id="@+id/active_session_title"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chrome_button_ripple"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/application_name"
            android:textColor="@color/terminal_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/top_new_session_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chrome_button_ripple"
            android:contentDescription="@string/action_new_session"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_tab"
            app:tint="@color/terminal_text_primary" />

        <ImageButton
            android:id="@+id/top_keyboard_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chrome_button_ripple"
            android:contentDescription="@string/action_toggle_soft_keyboard"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            app:tint="@color/terminal_text_secondary" />

        <ImageButton
            android:id="@+id/top_settings_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chrome_button_ripple"
            android:contentDescription="@string/action_open_settings"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:tint="@color/terminal_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_border_hairline" />

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/terminal_root_margin_horizontal"
        android:layout_marginVertical="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_alignParentTop="true">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <include
                layout="@layout/partial_termux_drawer"
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:layout_gravity="start" />

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:background="@color/terminal_bg_tab_strip"
            android:visibility="gone" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
