<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg_drawer"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Phone Top Bar (48dp portrait, 44dp landscape via dimens) -->
    <LinearLayout
        android:id="@+id/settings_phone_topbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/terminal_top_chrome_height"
        android:background="@color/terminal_bg_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/settings_phone_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chrome_button_ripple"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/terminal_text_primary" />

        <TextView
            android:id="@+id/settings_phone_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/settings_header_title"
            android:textColor="@color/terminal_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_reset_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="@string/settings_reset_short"
            android:textColor="@color/terminal_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_done_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="14dp"
            android:text="@string/settings_done"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/settings_topbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_border_hairline" />

    <FrameLayout
        android:id="@+id/settings_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Phone Root Category List -->
        <LinearLayout
            android:id="@+id/settings_sidebar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/settings_search_box"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/settings_search_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/terminal_text_secondary" />

                    <EditText
                        android:id="@+id/settings_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/settings_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/terminal_text_primary"
                        android:textColorHint="@color/terminal_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/settings_nav_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Phone Category Detail Scroll -->
        <LinearLayout
            android:id="@+id/settings_detail_column"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/settings_detail_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/settings_detail_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
