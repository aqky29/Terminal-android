<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg_drawer"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <!-- Tablet Master Left Sidebar -->
    <LinearLayout
        android:id="@+id/settings_sidebar"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:background="@color/terminal_bg_tab_strip"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/settings_sidebar_brand_icon_box"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/settings_sidebar_brand_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_terminal_prompt"
                        app:tint="@color/terminal_text_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_sidebar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_header_title"
                    android:textColor="@color/terminal_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_sidebar_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/terminal_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_search_box"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/settings_search_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/terminal_text_secondary" />

                <EditText
                    android:id="@+id/settings_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/settings_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/terminal_text_primary"
                    android:textColorHint="@color/terminal_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/settings_sidebar_top_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_border_hairline" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/settings_nav_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/settings_sidebar_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/terminal_border_hairline" />

    <!-- Tablet Right Detail Column -->
    <LinearLayout
        android:id="@+id/settings_detail_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/settings_tablet_detail_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/terminal_bg_chrome"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <FrameLayout
                android:id="@+id/settings_detail_header_icon_box"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/settings_detail_header_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/terminal_text_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_detail_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_header_title"
                    android:textColor="@color/terminal_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_detail_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/terminal_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_reset_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="12dp"
                android:text="@string/settings_reset_default"
                android:textColor="@color/terminal_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_done_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingHorizontal="16dp"
                android:text="@string/settings_done"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/settings_detail_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terminal_border_hairline" />

        <ScrollView
            android:id="@+id/settings_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/settings_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
